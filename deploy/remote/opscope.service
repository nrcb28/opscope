[Unit]
Description=Opscope read-only evidence behind an authenticated HTTPS proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opscope
Group=opscope
EnvironmentFile=/etc/opscope/opscope.env
WorkingDirectory=/var/lib/opscope
ExecStart=/opt/opscope/opscope serve --port 48321 --history /var/lib/opscope/history.sqlite --public-origin ${OPSCOPE_PUBLIC_ORIGIN} --proxy-token-env OPSCOPE_PROXY_TOKEN
Restart=on-failure
RestartSec=5
StateDirectory=opscope
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opscope
CapabilityBoundingSet=
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
